#!/bin/sh
# Conventional Commits 1.0.0 check (CONTRIBUTING.md). Enable once per clone:
#   git config core.hooksPath .githooks
msg=$(sed -n '/^[^#]/{p;q;}' "$1")
types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
case "$msg" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s\n' "$msg" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: .+"; then
    echo "commit-msg: not a Conventional Commit: \"$msg\"" >&2
    echo "  expected: <type>(<scope>): <subject>   types: $(echo $types | tr '|' ' ')" >&2
    echo "  see CONTRIBUTING.md" >&2
    exit 1
fi
