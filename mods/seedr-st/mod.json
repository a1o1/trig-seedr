{
 "id": "seedr",
 "version": "0.9.0",
 "title": "trig-seedr",
 "category": "Sequencer",
 "license": "GPL-3.0-or-later",
 "author": "Alan O'Leary",
 "description": "An offline pattern generator on the current track, for the Syntakt. TRIG, TRIG, TRIG opens it (after the Trig Parameters and Euclidean pages); TRIG held + PAGE opens it from anywhere. LEFT / RIGHT step its pages; YES renders the track's recipe from the original track (grid recording on), NO goes back to the original, FUNC + YES keeps the result. Writes go through the OS's own step routines. Emulator build (docs/plan-syntakt.md, S3).",
 "device": "syntakt",
 "os": "1.42",
 "sources": [
  "seedr.c",
  "../../frame/pages.c",
  "../../frame/preview.c",
  "../../frame/view.c",
  "../../lib/seed_render.c",
  "../../lib/seed_rng.c",
  "../../lib/src_random.c",
  "../../lib/src_euclid.c",
  "../../lib/src_map.c",
  "../../lib/map_data.c",
  "../../lib/src_copy.c", "../../lib/src_turing.c", "../../lib/scale.c",
  "../../lib/place.c",
  "../../lib/place_sync.c",
  "../../lib/place_mask.c",
  "../../lib/dyn.c",
  "../../lib/dyn_rank.c",
  "../../lib/dyn_noise.c",
  "../../lib/meter.c",
  "../../lib/values.c",
  "../../lib/values_list.c",
  "../../lib/noise.c",
  "../../lib/trig.c",
  "../../lib/timing.c",
  "../../lib/timing_drift.c",
  "../../lib/vary.c",
  "../../lib/score.c",
  "../../lib/yolo.c"
 ],
 "subscribe": [
  {
   "event": "ev_tick",
   "fn": "st_tick",
   "order": 60
  },
  {
   "event": "ev_draw",
   "fn": "st_draw",
   "order": 60
  },
  {
   "event": "ev_key",
   "fn": "st_key",
   "order": 40
  },
  {
   "event": "ev_enc",
   "fn": "st_enc",
   "order": 40
  }
 ],
 "cflags": [
  "-Os",
  "-fno-store-merging",
  "-Werror=return-type",
  "-fno-tree-loop-distribute-patterns"
 ],
 "requires": [
  "core"
 ]
}
